# ===================================================
# MINETECH 10/10 OUTBOUND SALES PLATFORM — ENVIRONMENT CONFIGURATION
# ===================================================

# Application
PORT=3000
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://app.minetech.io

# Authentication & Security
JWT_SECRET=your_long_random_jwt_secret_key_minimum_32_chars_hex
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=YourSecureAdminPassword!
# Anthropic Claude (AI personalization, drafting, research)
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here
# Optional pin. If omitted, MineTech asks Anthropic which current models this key can use.
# ANTHROPIC_MODEL=
# Optional: comma-separated model ids to try only if the primary is reported unavailable.
# ANTHROPIC_FALLBACK_MODELS=

# AI Brain v1 (optional - defaults shown). Autonomy is fixed at Level 1 (AI drafts, humans send).
# AI_BRAIN_ENABLED=true
# AI_BRAIN_TIMEOUT_MS=30000
# AI_BRAIN_MAX_RETRIES=2
# AI_BRAIN_MAX_FOLLOW_UPS=3
# AI_BRAIN_COOLDOWN_HOURS=48
# AI_BRAIN_DUPLICATE_WINDOW_HOURS=72

# Resend SMTP & Transactional Email Provider
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_signing_secret
EMAIL_FROM=outreach@yourdomain.com
EMAIL_FROM_NAME=MineTech Outbound
REPLY_TO=replies@yourdomain.com

# Listmonk Campaign Engine (Optional Docker Relay)
LISTMONK_URL=http://127.0.0.1:9000
LISTMONK_API_USERNAME=admin
LISTMONK_API_PASSWORD=your_listmonk_admin_password
LISTMONK_DB_HOST=127.0.0.1
LISTMONK_DB_PORT=5432
LISTMONK_DB_NAME=listmonk
LISTMONK_DB_USER=listmonk_user
LISTMONK_DB_PASSWORD=your_secure_postgres_password

# Twilio Channels (WebRTC Voice Dialer & SMS)
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_34_chars
TWILIO_AUTH_TOKEN=your_twilio_auth_token_32_chars
TWILIO_PHONE_NUMBER=+12345678901
TWILIO_TWIML_APP_SID=AP_your_twiml_app_sid_34_chars
TWILIO_API_KEY=SK_optional_api_key_for_webrtc
TWILIO_API_SECRET=optional_api_secret_for_webrtc

# CORS & Security
CORS_ALLOWED_ORIGINS=https://app.minetech.io
