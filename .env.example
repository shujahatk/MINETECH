# ===================================================
# 80/20 OUTBOUND WORKSTATION — ENVIRONMENT CONFIGURATION
# ===================================================

# Application
PORT=3000
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Admin (Set your own secure credentials)
JWT_SECRET=your_long_random_jwt_secret_key_minimum_32_chars
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=YourSecureAdminPassword!

# MongoDB Primary CRM Database (Source of Truth)
MONGODB_URI=mongodb://127.0.0.1:27017/80-20-outbound

# Listmonk Campaign Engine (Docker)
LISTMONK_URL=http://127.0.0.1:9000
LISTMONK_API_USERNAME=your_listmonk_admin_username
LISTMONK_API_PASSWORD=your_listmonk_admin_password

# Listmonk PostgreSQL Database (Exclusively for Listmonk)
LISTMONK_DB_HOST=127.0.0.1
LISTMONK_DB_PORT=5432
LISTMONK_DB_NAME=listmonk
LISTMONK_DB_USER=your_postgres_username
LISTMONK_DB_PASSWORD=your_secure_postgres_password

# Resend SMTP Delivery Provider (Configured for Listmonk Engine)
# Listmonk connects to Resend SMTP to deliver bulk campaigns
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=465
RESEND_SMTP_USER=resend
RESEND_SMTP_PASSWORD=re_your_resend_api_key_here

# Outbound Email Identities & Central Mailbox
EMAIL_FROM=outreach@yourcompany.com
EMAIL_FROM_NAME=Outbound Sales
REPLY_TO=replies@yourcompany.com

# Twilio Channels (Voice & SMS)
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+12345678901
TWILIO_TWIML_APP_SID=AP_your_twiml_app_sid

# AI Copywriting (Optional)
OPENAI_API_KEY=sk-your_openai_api_key_here
